{
  "extends": [
    "group:allNonMajor",
    ":maintainLockFilesWeekly"
  ],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "ignorePaths": ["crates/workspace-hack/**"],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "postUpgradeTasks": {
        "commands": [
          "cargo install cargo-hakari --locked",
          "cargo hakari generate"
        ],
        "executionMode": "branch"
      }
    }
  ]
}
