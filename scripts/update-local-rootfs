#!/usr/bin/env bash

set -e

scripts_dir="$(dirname -- "$0")"
project_dir="$(dirname -- "$scripts_dir")"
tmp_dir="$project_dir/tmp"
mountpoint="$tmp_dir/rootfs-mnt"
local_image="$tmp_dir/rootfs.ext4"

rootfsEnv="$(nix build '.#rootfs.rootfsEnv' --no-link --print-out-paths)"
closure="$(nix build '.#rootfs.closure' --no-link --print-out-paths)"
closure_base="$(nix build '.#rootfs-base.closure' --no-link --print-out-paths)"

sudo umount "$mountpoint" 2>/dev/null || true

sudo mount -o loop "$local_image" "$mountpoint"
sudo rm -rf "$mountpoint/overlay"
sudo cp -a "$rootfsEnv" "$mountpoint/overlay"

sudo mkdir -p "$mountpoint/overlay/nix/store"
comm -23 <(sort "$closure") <(sort "$closure_base") | while read -r path; do
  echo "$path"
  sudo cp -a "$path" "$mountpoint/overlay$path"
done

sudo umount "$mountpoint"
